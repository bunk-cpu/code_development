# 仅本机演示。修改口令后再启动；服务只监听 127.0.0.1。
DEMO_PASSWORD=demo-only
DEMO_DB=data/demo.sqlite3
# 推荐 PostgreSQL；置空时使用 SQLite 本机兼容模式。
DATABASE_URL=postgresql:///source_knowledge
TESTPILOT_BASE_URL=http://127.0.0.1:8099
# 旧系统启用登录时才填写；不保存到新系统数据库。
TESTPILOT_EMAIL=
TESTPILOT_PASSWORD=
TESTPILOT_ALLOW_RUN=false
TESTPILOT_ENV_FILE=/root/testpilot-plus/.env
# 以下留空则从上述 env 读取 GATEWAY_BASE_URL / GATEWAY_MODEL / GATEWAY_API_KEY。
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=
MODEL_TIMEOUT_S=60
AGENT_TOKEN_BUDGET=60000
# 多个目录以 Linux 的冒号分隔；仓库与依赖 JAR 均须在白名单内。
SOURCE_ALLOWED_ROOTS=/root/code_development
# Git Webhook 与分页游标的独立签名密钥，从环境/密钥管理注入。
GIT_WEBHOOK_SECRET=
CURSOR_SECRET=
MOCK_BUSINESS_BASE_URL=http://127.0.0.1:9100
MOCK_SECRET=demo-mock-only
